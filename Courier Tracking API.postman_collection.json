    {
      "name": "Get Total Distance - Non-existent Courier",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Distance should be 0 for new courier\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.data.totalDistance).to.eql(0);",
              "    });",
