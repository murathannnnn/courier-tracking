    {
      "name": "Get Store Entries",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains store entries\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Store entries have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data.length > 0) {",
              "        var entry = jsonData.data[0];",
              "        pm.expect(entry).to.have.property('storeName');",
              "        pm.expect(entry).to.have.property('entryTime');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/couriers/{{courierId}}/store-entries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "couriers",
            "{{courierId}}",
            "store-entries"
          ]
        },
        "description": "Get all store entries for a courier"
      },
      "response": []
    },
    {
      "name": "Get Total Distance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains courier data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('courierId');",
              "    pm.expect(jsonData.data).to.have.property('totalDistance');",
              "    pm.expect(jsonData.data.totalDistance).to.be.a('number');",
              "});",
              "",
              "pm.test(\"Total distance is positive\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.totalDistance).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/couriers/{{courierId}}/total-distance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "couriers",
            "{{courierId}}",
            "total-distance"
          ]
        },
        "description": "Get the total travel distance for a courier"
      },
      "response": []
    },
